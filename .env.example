# Bambu Cloud MQTT (China region example)
BAMBU_MQTT_HOST=cn.mqtt.bambulab.com
BAMBU_MQTT_PORT=8883
BAMBU_USER_ID=your_uid
BAMBU_ACCESS_TOKEN=your_access_token
BAMBU_DEVICE_ID=your_printer_device_id

# Yi camera / yi-hack
YI_IP=192.168.2.194
YI_USER=admin
YI_PASSWORD=your_camera_password

# Snapshot source: auto = RTSP first, HTTP fallback
CAPTURE_SOURCE=auto

# RTSP is built automatically from YI_IP/YI_USER/YI_PASSWORD.
YI_RTSP_PORT=554
YI_RTSP_PATH=/ch0_0.h264

# Optional full override for non-standard Yi Hack setups.
YI_RTSP_URL=
RTSP_CAPTURE_TIMEOUT=4
RTSP_FRAME_RATE=5
RTSP_FRAME_MAX_AGE=1.0

# Capture automation
AUTO_CAPTURE=true
SNAPSHOT_DELAY=0.5
SNAPSHOT_RETRIES=3
CAPTURE_EVERY_LAYERS=1

# Video
AUTO_GENERATE_VIDEO=true
TIMELAPSE_FPS=30
TIMELAPSE_DIR=./data/timelapse

# Storage / Web
DATABASE_PATH=./data/db/app.db
WEB_DIST=./web/dist
WEB_PORT=8000
