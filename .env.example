# Bambu Cloud MQTT (China region example)
BAMBU_MQTT_HOST=cn.mqtt.bambulab.com
BAMBU_MQTT_PORT=8883
BAMBU_USER_ID=your_uid
BAMBU_ACCESS_TOKEN=your_access_token
BAMBU_DEVICE_ID=your_printer_device_id

# Camera source
# yi   = Yi / yi-hack with RTSP + optional HTTP snapshot fallback
# rtsp = Generic RTSP source, e.g. Android phone, IP camera, MediaMTX
CAMERA_TYPE=yi
CAMERA_NAME=Camera

# Generic RTSP source. Required when CAMERA_TYPE=rtsp.
# Example: rtsp://192.168.2.120:8554/live
CAMERA_RTSP_URL=

# Yi camera / yi-hack compatibility settings
YI_IP=192.168.2.194
YI_USER=admin
YI_PASSWORD=your_camera_password
YI_RTSP_PORT=554
YI_RTSP_PATH=/ch0_0.h264
YI_RTSP_URL=

# Snapshot source:
# auto = RTSP first, Yi-only HTTP fallback
# rtsp = RTSP only
# http = Yi HTTP snapshot only
CAPTURE_SOURCE=auto

RTSP_FRAME_RATE=5
RTSP_FRAME_MAX_AGE=1.0
RTSP_STALE_TIMEOUT=5.0
RTSP_STARTUP_TIMEOUT=8.0
RTSP_RECONNECT_DELAY=2.0
HTTP_SNAPSHOT_TIMEOUT=8.0

# Keep recent RTSP frames in memory so capture can rewind to a moment
# before Bambu's layer-change notification arrives.
# CAPTURE_REWIND_MS is the target time before the MQTT trigger.
RTSP_HISTORY_FRAMES=60

# Rewind strategy defaults. Runtime values can be changed in the web UI
# and are stored in SQLite.
CAPTURE_REWIND_MODE=time
CAPTURE_REWIND_FRAMES=5
CAPTURE_REWIND_MS=1000

# Capture automation
AUTO_CAPTURE=true
SNAPSHOT_RETRIES=3
CAPTURE_EVERY_LAYERS=1

# Video
AUTO_GENERATE_VIDEO=true
TIMELAPSE_FPS=30
TIMELAPSE_DIR=./data/timelapse

# Storage / Web
DATABASE_PATH=./data/db/app.db
WEB_DIST=./web/dist
WEB_PORT=8000
